# Every value below is optional. Sponsor Engine runs with no keys.
# Copy this file to .env only if you want to change a value.

# Test mode. true means nothing is sent. Leave it true.
DRY_RUN=true

# Addresses that may be marked sent when DRY_RUN=false. Leave this empty.
ALLOWLIST=

# Leave empty to use SQLite at data/sponsor-engine.db.
# Set a Postgres URL to use Supabase. Use the direct URL on port 5432 for the seed command.
DATABASE_URL=

# Set true on the public site. The site stays in test mode and does not send messages.
DEMO_MODE=

# Public site address. Set it before the build. The MCP page uses it in the connect snippets.
NEXT_PUBLIC_APP_URL=

# Optional bearer token for /api/mcp. Leave empty on the public demo.
MCP_TOKEN=

# Optional path for the SQLite file.
SPONSOR_ENGINE_DB=

# Port for the MCP HTTP server.
PORT=8787

# Bring your own tools. Leave these empty to keep the built-in tools.
ZERO_API_KEY=
TWENTY_API_URL=
TWENTY_API_KEY=
COGNEE_API_KEY=
COMPANIES_HOUSE_API_KEY=
