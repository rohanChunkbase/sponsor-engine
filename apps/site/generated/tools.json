    },
    {
      "name": "approve",
      "title": "Approve a waiting message",
      "description": "Move an outbox item to approved. In test mode this only logs and does not send. Calls pushDeal when packages/integrations is present.",
      "input": [
        {
          "name": "outbox_id",
          "type": "string",
          "required": true,
          "description": ""
        },
        {
          "name": "actor",
          "type": "string",
          "required": false,
          "description": ""
        }
      ],
      "exampleCall": {
        "outbox_id": "out_example",
        "actor": "organiser"
      },
      "exampleResult": {
        "sent": false,
        "reason": "Approved. Test mode is on, so nothing was sent.",
        "deal": {
          "used": "built-in"
        },
        "item": {
          "id": "out_example",
          "status": "approved"
        },
        "note": "Test mode is the default. Approve writes a log. The row stays approved. The row moves to sent only when DRY_RUN is false and the recipient is on the allow list."
      }
    },
    {
      "name": "list_failures",
      "title": "List failures",
      "description": "Show messages the assistant could not read.",
      "input": [
        {
          "name": "limit",
          "type": "number",
          "required": false,
          "description": ""
        }
      ],
      "exampleCall": {
        "limit": 20
      },
      "exampleResult": [
        {
          "id": "fail_example",
          "tool": "triage_inbound",
          "request_id": "req_example",
          "message": "The message has no date and no headcount.",
          "raw_input": "Can you help us find a sponsor?",
          "created_at": "2026-10-22T18:00:00.000Z"
        }
      ]
    },
    {
      "name": "recall_history",
      "title": "Recall history",
      "description": "Look up past events, bookings, and sponsor notes. Uses Cognee recall when packages/integrations is present. Uses the local database otherwise.",
