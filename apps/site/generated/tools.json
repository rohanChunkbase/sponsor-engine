{
  "source": "packages/mcp/src/server.ts",
  "server": "sponsor-engine",
  "version": "0.1.0",
  "tools": [
    {
      "name": "triage_inbound",
      "title": "Read an inbound message",
      "description": "Read a chat message. Record who is asking, whether they are a community or a company, the date, the headcount, and what they need. Create a task with an owner and a priority. Log a failure when the message cannot be read. The reply waits for a person.",
      "input": [
        {
          "name": "message",
          "type": "string",
          "required": true,
          "description": "The chat message"
        },
        {
          "name": "channel",
          "type": "string",
          "required": false,
          "description": "whatsapp, email, or web"
        },
        {
          "name": "sender_name",
          "type": "string",
          "required": false,
          "description": ""
        }
      ],
      "exampleCall": {
        "message": "This is Amina from Thames Agent Builders. Can we book an evening hack for 80 people on 12 November 2026? We need food.",
        "channel": "whatsapp",
        "sender_name": "Amina"
      },
      "exampleResult": {
        "ok": true,
        "qualified": {
          "sender_name": "Amina",
          "organisation": "Thames Agent Builders",
          "requester_kind": "community",
          "event_date": "2026-11-12",
          "headcount": 80,
          "needs": [
            "food",
            "evening"
          ],
          "venue_hint": null,
          "owner": "Venue lead",
          "priority": "p1"
        },
        "task": {
          "title": "Book Thames Agent Builders — 80 people",
          "owner": "Venue lead",
          "priority": "p1",
          "status": "open"
        },
        "outbox": {
          "status": "awaiting_approval",
          "kind": "chat_reply"
        },
        "suggested_reply": "Thanks Amina. I have this as a community booking for Thames Agent Builders on 12 November 2026 for 80 people. You asked for food, evening. A person here will confirm the price before anyone replies."
      }
    },
    {
      "name": "quote_booking",
      "title": "Quote a booking",
      "description": "Price a booking from past bookings and explain the community rate and the company rate in plain language. Uses packages/pricing quotePrice when that package is present.",
      "input": [
        {
          "name": "request_id",
          "type": "string",
          "required": false,
          "description": ""
        },
        {
          "name": "requester_kind",
          "type": "community | company | unknown",
          "required": false,
          "description": ""
        },
        {
          "name": "headcount",
          "type": "number",
          "required": false,
          "description": ""
        },
        {
          "name": "date",
          "type": "string",
          "required": false,
          "description": ""
        },
        {
          "name": "community_name",
          "type": "string",
          "required": false,
          "description": ""
        },
        {
          "name": "needs",
          "type": "string[]",
          "required": false,
          "description": ""
        }
      ],
      "exampleCall": {
        "requester_kind": "community",
        "headcount": 80,
        "date": "2026-11-12",
        "community_name": "A new community",
        "needs": [
          "food",
          "evening"
        ]
      },
      "exampleResult": {
        "price": 0,
        "currency": "GBP",
        "range": {
          "low": 0,
          "high": 0
        },
        "requester_kind": "community",
        "source": "pricing-module",
        "lines": {
          "room_gbp": 0,
          "food_gbp": 319,
          "expected_heads": 58,
          "show_up_rate": 0.72,
          "food_per_head": 5.5,
          "sponsor_ask_gbp": 319,
          "range": {
            "low": 0,
            "high": 0
          },
          "community_room_gbp": 0,
          "community_range": {
            "low": 0,
            "high": 0
          },
          "company_room_gbp": 2805,
          "company_range": {
            "low": 2320,
            "high": 3645
          }
        },
        "note": "Room prices are the SAMPLE history for this request: evening, 4 hours, no AV, repeat count 0. Food uses the 72% show-up benchmark. Your history can change the numbers. Do not use the SAMPLE prices for a real venue."
      }
    },
    {
      "name": "find_sponsors",
      "title": "Find sponsors",
      "description": "Rank sponsors for an event from past London backing, food or venue fit, and size. Return reasons and source URLs. Calls companySize and lumaEventHosts when packages/integrations is present.",
      "input": [
        {
          "name": "request_id",
          "type": "string",
          "required": false,
          "description": ""
        },
        {
          "name": "community",
          "type": "string",
          "required": false,
          "description": ""
        },
        {
          "name": "headcount",
          "type": "number",
          "required": false,
          "description": ""
        },
        {
          "name": "needs",
          "type": "string[]",
          "required": false,
          "description": ""
        },
        {
          "name": "focus",
          "type": "string",
          "required": false,
          "description": ""
        },
        {
          "name": "limit",
          "type": "number",
          "required": false,
          "description": ""
        },
        {
          "name": "include_sample",
          "type": "boolean",
          "required": false,
          "description": ""
        }
      ],
      "exampleCall": {
        "community": "Encode Club",
        "headcount": 80,
        "needs": [
          "food"
        ],
        "focus": "ai",
        "limit": 3,
        "include_sample": false
      },
      "exampleResult": {
        "live_note": "Live lookup is off. These matches use the London sponsor list on this computer.",
        "matches": [
          {
            "company": "Anthropic",
            "website": "anthropic.com",
            "category": "AI lab",
            "london_events": 6,
            "food_or_drinks_events": 1,
            "reasons": [
              "Anthropic is named as paying for food or drinks at 2 London events. One page says: “We will provide food and drink, thanks to Anthropic!”"
            ],
            "sources": [
              {
                "url": "https://luma.com/4z45zkng",
                "quote": "We will provide food and drink, thanks to Anthropic!",
                "role": "food",
                "confidence": "stated",
                "event_name": "Claude Code Meetup London",
                "community": "Claude Community Events"
              }
            ]
          }
        ],
        "note": "A live call also returns sponsor_id, score, venue_events, and is_sample. The rank uses the London list on this computer."
      }
    },
    {
      "name": "forecast_turnout",
      "title": "Forecast turnout",
      "description": "Estimate how many people will come. Uses this community's history when it has at least three events. Otherwise uses the free-event no-show benchmark of 28%.",
      "input": [
        {
          "name": "headcount",
          "type": "number",
          "required": true,
          "description": ""
        },
        {
          "name": "requester_kind",
          "type": "community | company | unknown",
          "required": false,
          "description": ""
        },
        {
          "name": "community_name",
          "type": "string",
          "required": false,
          "description": ""
        },
        {
          "name": "request_id",
          "type": "string",
          "required": false,
          "description": ""
        }
      ],
      "exampleCall": {
        "headcount": 80,
        "requester_kind": "community",
        "community_name": "A new community"
      },
      "exampleResult": {
        "headcount": 80,
        "expected_heads": 58,
        "show_up_rate": 0.72,
        "no_show_rate": 0.28,
        "source": "benchmark",
        "history_events": 0,
        "community_name": "A new community",
        "benchmark": {
          "no_show_rate": 0.28,
          "show_up_rate": 0.72,
          "note": "Free events with no history use a 28% no-show. Show-up is 72%."
        },
        "summary": "There are fewer than three past events for this requester. We use the free-event benchmark: a 28% no-show, so 72% show-up. We expect 58 of 80 people.",
        "note": "This is the benchmark path. The benchmark runs when the database has fewer than three past bookings of this kind. Three or more bookings use the median show-up from that history."
      }
    },
    {
      "name": "draft_sponsor_ask",
      "title": "Draft a sponsor email",
      "description": "Draft a right-sized sponsor ask from the turnout forecast, about £5.50 per person for food. Put the email in the outbox. Do not send it.",
      "input": [
        {
          "name": "request_id",
          "type": "string",
          "required": false,
          "description": ""
        },
        {
          "name": "sponsor_id",
          "type": "string",
          "required": false,
          "description": ""
        },
        {
          "name": "sponsor_name",
          "type": "string",
          "required": false,
          "description": ""
        },
        {
          "name": "headcount",
          "type": "number",
          "required": false,
          "description": ""
        },
        {
          "name": "community",
          "type": "string",
          "required": false,
          "description": ""
        }
      ],
      "exampleCall": {
        "headcount": 80,
        "community": "A new community"
      },
      "exampleResult": {
        "ask_gbp": 319,
        "per_head_gbp": 5.5,
        "expected_heads": 58,
        "show_up_rate": 0.72,
        "sent": false,
        "outbox": {
          "status": "awaiting_approval",
          "kind": "sponsor_email"
        },
        "note": "The ask is the food cost. It is £5.50 for each person the forecast expects. The email waits in the outbox. The tool does not send it."
      }
    },
    {
      "name": "send_with_approval",
      "title": "Queue a message for approval",
      "description": "Never sends. Writes the message to the outbox with status awaiting_approval.",
