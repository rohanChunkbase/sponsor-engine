{
  "name": "@sponsor-engine/pricing",
  "version": "0.1.0",
  "description": "Quote a venue booking from past bookings. Communities pay less than companies. The SAMPLE history is fictional.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "tsx src/cli/generate-sample.ts",
    "evaluate": "tsx src/cli/evaluate.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
